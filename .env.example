# Supabase Postgres connection strings.
# DATABASE_URL: the pooled "Transaction" mode URI (used by the running app).
# DIRECT_URL:   the direct/session URI (used only for migrations).
# Find both under Supabase Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:5432/postgres?sslmode=require"

# NOT currently read anywhere in application code — sessions use a random
# opaque DB-backed token (see src/lib/session.ts), not a JWT, so there's
# nothing for this to sign. Kept here only because some hosting setups
# still expect it to be present; safe to leave unset. Do not rely on this
# for anything security-sensitive.
# AUTH_SECRET="replace-with-a-long-random-secret"

# Base URL of the app — used for building absolute links (QR codes, password
# reset emails, payment gateway callbacks) AND as the single source of truth
# for every SEO surface (canonical URLs, OpenGraph/Twitter tags, sitemap.xml,
# robots.txt, JSON-LD — see src/lib/seo/site.ts). In production this MUST be
# the real public domain, not localhost — src/lib/seo/site.ts falls back to
# https://restrokendra.com outside development if this is ever misconfigured,
# but that fallback is a safety net, not a substitute for setting this
# correctly in the actual deploy environment.
APP_URL="http://localhost:3000"
# Production value:
# APP_URL="https://restrokendra.com"

# Google Analytics (GA4) measurement ID — see src/lib/seo/analytics.ts.
# Must be NEXT_PUBLIC_ (unlike APP_URL) since it has to reach the client
# bundle for gtag.js to load at all; it's not a secret. Leave unset locally
# — src/app/layout.tsx only renders the gtag scripts when this resolves to
# a value, which it deliberately does not in development (see that file's
# fallback logic), so working in this repo never sends test traffic into
# the real GA property.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-12QPHRRPNV"

# Optional. Set BOTH to upgrade src/lib/rate-limit.ts from its default
# in-memory (single-process only) rate limiter to a distributed one backed
# by Upstash Redis's REST API — required once this app runs as more than
# one process/instance (a load balancer, multiple Vercel function
# instances, or `pm2 -i <n>` cluster mode), since an in-memory counter
# isn't shared across them. Leave both unset for local dev / a genuinely
# single-instance deployment; setting only one is treated as "not
# configured" and silently keeps the in-memory behavior. Get free values
# from https://console.upstash.com (Redis database -> REST API).
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="replace-with-your-upstash-rest-token"

# Number of reverse proxies in front of this app that are trusted to
# APPEND (never rewrite) an X-Forwarded-For entry — used by getClientIp()
# (src/lib/request.ts) to pick the one reliable IP out of that header
# instead of the client-controlled leftmost entry, which would otherwise
# let a request trivially spoof its way past every IP-keyed rate limit.
# Defaults to 1, matching the actual single-instance Hostinger deployment
# target (app process behind one reverse proxy) — only raise this if a
# real deployment adds another hop (e.g. a CDN/WAF) in front of that.
# TRUSTED_PROXY_COUNT="1"

# Do NOT set NODE_ENV here (or in Vercel/Netlify env var dashboards). Next.js
# forces NODE_ENV=production internally during `next build` regardless of
# what's in the environment, and on Next 16 a conflicting explicit value was
# confirmed (see the README's "Deploying to Netlify" section) to crash the
# /_global-error prerender step. Leave it unset locally too — `next dev` and
# `next build`/`next start` each set the correct value on their own.

# --- Payment gateways (Phase 11c) -------------------------------------------
# eSewa ePay v2. Leave unset to use eSewa's own publicly documented UAT
# sandbox credentials (product code EPAYTEST) — safe for local dev, only
# works against eSewa's sandbox. Set real values (and ESEWA_ENV=production)
# once you have a live eSewa merchant account.
ESEWA_ENV="test"
# ESEWA_PRODUCT_CODE="EPAYTEST"
# ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q("

# Khalti KPG v2. Unlike eSewa, Khalti has NO shared sandbox key — sign up
# free at https://test-admin.khalti.com to get your own test secret key.
# Required; there is no default and Khalti payments will fail without it.
KHALTI_ENV="test"
KHALTI_SECRET_KEY="replace-with-your-khalti-test-secret-key"

# --- AI assistant (Phase 11d, provider swap in Phase 14) -------------------
# Powers the owner/manager analytics assistant at /dashboard/assistant.
# AI_PROVIDER picks which config below is used — "groq" (default, free tier)
# or "anthropic". Only the selected provider's key is required at runtime.
# AI_PROVIDER="groq"

# Groq (default provider) — free tier, no credit card. Generate a key at
# https://console.groq.com/keys.
GROQ_API_KEY="replace-with-your-groq-api-key"
# Optional — defaults to a free-tier-eligible model if unset.
# GROQ_MODEL="llama-3.3-70b-versatile"

# Anthropic (alternate provider, set AI_PROVIDER="anthropic" to use it).
# Generate one at https://console.anthropic.com (Account Settings -> API Keys).
# ANTHROPIC_API_KEY="replace-with-your-anthropic-api-key"
# Optional — defaults to a fast/cheap model if unset. Override if the
# default has been retired; see https://docs.claude.com/en/docs/about-claude/models
# ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# --- AI Provider Control Center (Phase 7) -----------------------------------
# Required ONLY once a platform admin configures a provider at
# /admin/ai-providers (src/lib/ai/provider-config-db.ts) — encrypts each
# provider's API key (AES-256-GCM) before it's stored in the
# ai_provider_configs table. Not needed for the env-var-based AI_PROVIDER/
# GROQ_API_KEY/ANTHROPIC_API_KEY setup above, which keeps working unchanged
# until an admin actually adds a DB-backed provider config.
#
# Must be a base64-encoded 32-byte key. Generate one with:
#   openssl rand -base64 32
#
# Losing this key makes every already-stored provider key permanently
# undecryptable — there's no recovery path short of re-entering each
# provider's key from scratch. Treat it like a database credential: never
# commit it, and back it up with the same care as DATABASE_URL.
# AI_CONFIG_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"

# --- Web Push (Phase 25) -----------------------------------------------------
# Powers real system notifications for new orders — the kind that show up
# even if the dashboard/app is completely closed, not just backgrounded.
# REQUIRED for that to work at all: with these unset, "Turn on notifications"
# in the dashboard header still requests browser permission but silently has
# nothing to actually push through once the tab/app is closed.
#
# Generate your OWN keypair (never reuse an example/shared one — the private
# key must stay secret to this deployment):
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY="replace-with-your-generated-public-key"
# VAPID_PRIVATE_KEY="replace-with-your-generated-private-key"
# VAPID_SUBJECT is a contact the push services (Chrome/Firefox's backing
# infra) may use to reach you if this deployment is misbehaving — a mailto:
# address or an https:// URL, either is valid.
# VAPID_SUBJECT="mailto:you@yourdomain.com"

# --- Transactional email (Commercial Launch Phase B.3) ----------------------
# Powers the "forgot password" reset-link email AND the existing Web Push
# fallback alert email (src/lib/email.ts) — both go through the same Resend
# HTTP API call. Optional, but REQUIRED for forgot-password to actually
# deliver anything: with RESEND_API_KEY unset, requesting a reset link is a
# silent no-op (the request endpoint still returns its generic success
# response either way, so as not to reveal whether an account exists — see
# that route's own comment) and a locked-out user has no self-service path
# until an owner/manager resets their password directly from the Staff page
# instead. Sign up at https://resend.com to get a key; RESEND_FROM_ADDRESS
# needs to be a domain you've verified with Resend to send from in
# production (the resend.dev default only works for testing).
# RESEND_API_KEY="replace-with-your-resend-api-key"
# RESEND_FROM_ADDRESS="alerts@resend.dev"

# --- Error monitoring (Phase 2 P1) ------------------------------------------
# Optional. With these unset, error monitoring is a complete no-op — every
# Sentry.init() call is skipped outright, nothing is sent anywhere, and the
# app behaves exactly as if @sentry/nextjs weren't installed. See
# SENTRY_SETUP.md for what a real Sentry project setup looks like and the
# bundle-size trade-off worth reading before turning this on.
#
# Same DSN value in both — NEXT_PUBLIC_SENTRY_DSN reaches the browser bundle
# at build time, SENTRY_DSN stays server-only. A DSN is not secret (it only
# allows sending events, not reading your project), unlike everything below it.
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX"
# SENTRY_DSN="https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX"

# Optional — labels events by deploy environment in Sentry's UI. Defaults to
# NODE_ENV if unset.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# SENTRY_ENVIRONMENT="production"

# Optional — enables source-mapped stack traces at build time. Without these,
# Sentry still receives error reports (via the DSN above), just with
# minified/unmapped stack traces. SENTRY_AUTH_TOKEN is a real secret — create
# one at Settings -> Auth Tokens with `project:releases` scope, never commit
# it, same handling as AUTH_SECRET/VAPID_PRIVATE_KEY above.
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_AUTH_TOKEN="replace-with-your-sentry-auth-token"

# --- Object storage for attendance selfies (Phase 12, Attendance overhaul) --
# Optional. With these unset, selfie-verified attendance is unavailable:
# owners can't turn on the "require a selfie to clock in/out" toggle (Staff
# -> Attendance), and the upload-url/photo-view routes return 503. Every
# other attendance feature (plain clock-in/out, notes, reports) works exactly
# as before regardless.
#
# Works with any S3-compatible provider — AWS S3, Cloudflare R2, Backblaze
# B2, or a self-hosted MinIO — they all speak the same S3 API, so no code
# changes are needed between providers, only these env vars.
#
# REQUIRED to turn the feature on, all four:
# OBJECT_STORAGE_REGION="ap-south-1"
# OBJECT_STORAGE_BUCKET="replace-with-your-bucket-name"
# OBJECT_STORAGE_ACCESS_KEY_ID="replace-with-your-access-key-id"
# OBJECT_STORAGE_SECRET_ACCESS_KEY="replace-with-your-secret-access-key"
#
# Provider-specific:
# - Real AWS S3: leave OBJECT_STORAGE_ENDPOINT unset, use a real AWS region
#   above, leave OBJECT_STORAGE_FORCE_PATH_STYLE unset.
# - Cloudflare R2 / Backblaze B2 / MinIO: set OBJECT_STORAGE_ENDPOINT to that
#   provider's S3-compatible endpoint URL, OBJECT_STORAGE_REGION can be
#   "auto" (they ignore the value), and set OBJECT_STORAGE_FORCE_PATH_STYLE
#   to "true".
# OBJECT_STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# OBJECT_STORAGE_FORCE_PATH_STYLE="true"
#
# IMPORTANT — the browser uploads a selfie directly to the bucket via a
# presigned PUT URL (this server never touches the photo bytes), so the
# bucket itself needs CORS configured to allow PUT requests with an
# image/jpeg Content-Type from this app's own origin(s). Consult your
# provider's docs for "CORS configuration" / "bucket CORS policy" — every S3-
# compatible provider supports this, the exact console/CLI steps differ.
#
# How long a selfie is kept before the retention purge (Admin -> System, or
# an external cron hitting POST /api/admin/system/purge-attendance-photos)
# deletes it. This is this product's own operational default, NOT a number
# Nepal's Individual Privacy Act, 2075 (2018) itself specifies — see
# src/lib/attendance-consent.ts's own comment. Defaults to 90 if unset.
# ATTENDANCE_PHOTO_RETENTION_DAYS="90"
